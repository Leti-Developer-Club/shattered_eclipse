[node name="Page1" type="Label" parent="LeftPage" unique_id=1484645659]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("3_font")
theme_override_font_sizes/font_size = 13
text = "The Sankofa symbol represents the Akan concept: 'Se wo were fi na wosankofa a yenkyi' - 'It is not taboo to go back and fetch what you forgot.' This wisdom teaches that we must look to the past to build a successful future."
autowrap_mode = 3

[node name="Page2" type="Label" parent="LeftPage" unique_id=1058087892]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("3_font")
theme_override_font_sizes/font_size = 13
text = "You have journeyed through the histories of the Anufo smiths, the Ashanti empire, the Ga migrations, and the Fante coastal traditions. Each piece of knowledge you've gathered represents a fragment of Africa's rich heritage that must never be forgotten."
autowrap_mode = 3

[node name="RightPage" type="VBoxContainer" parent="." unique_id=75005863]
layout_mode = 0
offset_left = 351.0
offset_top = 140.0
offset_right = 580.0
offset_bottom = 440.0
theme_override_constants/separation = 15

[node name="Page3" type="Label" parent="RightPage" unique_id=549303334]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("3_font")
theme_override_font_sizes/font_size = 13
text = "As a master Griot, you now carry the responsibility of preserving and sharing these stories. The Sun-Scrolls are restored, and the light of African history shines bright once more. Remember: learning from the past is not dwelling on it, but honoring it to create a better tomorrow."
autowrap_mode = 3

